# CareBot Platform - environment variables
# Copy this file to .env and adjust for local development.

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://carebot:carebot@localhost:5432/carebot

# Redis (escalation timers / background jobs)
REDIS_URL=redis://localhost:6379/0

# Auth (JWT)
SECRET_KEY=dev-secret-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Frontend / simulator
VITE_API_BASE_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
